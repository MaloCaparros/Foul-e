# Port d'écoute du serveur
PORT=3000

# Base de données PostgreSQL. Sans cette variable, l'application utilise une base
# PostgreSQL embarquée (PGlite) stockée dans DATA_DIR : pratique en local, à éviter en production.
# DATABASE_URL=postgres://foulee:mot-de-passe@localhost:5432/foulee
# DATA_DIR=./data/pgdata

# "production" active les cookies sécurisés (HTTPS obligatoire) et HSTS.
# NODE_ENV=production

# Mettre à false une fois ton compte créé pour fermer les inscriptions.
ALLOW_REGISTRATION=true

# Durée des sessions de connexion, en jours.
SESSION_DAYS=30

# Clé API Anthropic : active la génération des programmes, menus et bilans par Claude.
# Sans clé, l'application fonctionne avec son générateur intégré.
# ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut claude-opus-5-5).
# AI_MODEL=claude-opus-5-5
